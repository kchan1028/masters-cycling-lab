# Copy to .env and edit. .env is git-ignored; never commit real keys.
# Every value is read by the backend (src/masters_cycling_lab/config.py), which validates it at startup.
# Nothing in this file is sent to the browser.

APP_ENV=development
# JSON list of browser origins allowed to call the API directly. Only the Vite dev server needs this;
# in Docker the frontend and API share one origin. CORS is not authentication.
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# JSON list of Host header names the API answers to. Blocks DNS-rebinding attacks from web pages.
ALLOWED_HOSTS=["127.0.0.1","localhost"]

# --- Database -----------------------------------------------------------------
# Compose builds the containers' URL from POSTGRES_PASSWORD. DATABASE_URL is for tools and tests on the
# host, so keep the two passwords the same. Postgres is published on 127.0.0.1:5433 only.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://mcl:change-me-local-only@127.0.0.1:5433/mcl

# Uploaded PDFs, for an API run on the host (relative to the repository root).
# Compose overrides this with a Docker volume at /data/storage.
STORAGE_ROOT=data/storage

# --- Embeddings ---------------------------------------------------------------
# Changing the model, revision or dimension means re-embedding every document. The database
# column is vector(384), so a different dimension also needs a migration. See docs/decisions.
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
# Full commit hash from huggingface.co. Branch names are rejected because they move.
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
# Where `make download-model` puts the model, for tools on the host. Compose uses a Docker volume.
MODEL_CACHE_DIR=data/models

# Chunk size in model tokens (bge-small reads at most 510 plus 2 special tokens) and the overlap between
# neighbouring chunks. Changing these only affects documents ingested afterwards; reindex the rest.
CHUNK_MAX_TOKENS=300
CHUNK_OVERLAP_TOKENS=40

# --- Answer generation (OpenAI-compatible /chat/completions) -----------------
# Leave LLM_BASE_URL or LLM_MODEL empty to run without generation: upload, search and
# evaluation of retrieval still work. Questions and retrieved passages are sent to this
# provider when you ask for an answer.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
# The model's context window. The server keeps prompt + evidence + output under this.
LLM_CONTEXT_WINDOW_TOKENS=8192

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=300
# Candidates ranked by vector search, and how many of them can go to the LLM as evidence.
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_CONTEXT_K=6

# --- Worker -------------------------------------------------------------------
WORKER_POLL_SECONDS=2
